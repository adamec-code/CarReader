<Window
  x:Class="CarReader.Presentation.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:CarReader.Presentation"
  mc:Ignorable="d"
  Title="CarReader"
  Height="450"
  Width="420"
>
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding InfoMessage}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding Version}" FontWeight="Bold" />
      </StatusBarItem>
    </StatusBar>
    <Grid Margin="0,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28*" />
        <ColumnDefinition Width="119*" />
        <ColumnDefinition Width="653*" />
      </Grid.ColumnDefinitions>
      <Button Content="Nahrát soubor" Width="152" Height="40" Command="{Binding UploadDataCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="54,10,0,0" Grid.Column="2" />

      <ScrollViewer Grid.ColumnSpan="3" Margin="10,55,0,10">
        <StackPanel>
          <!-- HEADER -->
          <Border BorderBrush="Black" BorderThickness="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- Levý horní -->
              <Border BorderBrush="Black" BorderThickness="0,0,2,1" Padding="5">
                <TextBlock Text="Název modelu" FontWeight="Bold" />
              </Border>
              <!-- Pravý přes 2 řádky -->
              <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" BorderBrush="Black" Padding="5">
                <TextBlock Text="Cena s DPH" FontWeight="Bold" VerticalAlignment="Center" />
              </Border>
              <!-- Levý spodní -->
              <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,2,0" Padding="5">
                <TextBlock Text="Cena bez DPH" FontWeight="Bold" />
              </Border>
            </Grid>
          </Border>
          <!-- DATA -->
          <ItemsControl ItemsSource="{Binding Cars}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="Black" BorderThickness="2,0,2,2">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Název modelu -->
                    <Border BorderBrush="Black" BorderThickness="0,0,2,1" Padding="5">
                      <TextBlock Text="{Binding Name}" />
                    </Border>
                    <!-- Cena s DPH -->
                    <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" BorderBrush="Black" Padding="5">
                      <TextBlock Text="{Binding PriceWithVat, StringFormat=N2}" VerticalAlignment="Center" />
                    </Border>
                    <!-- Cena bez DPH -->
                    <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,2,0" Padding="5">
                      <TextBlock Text="{Binding Price, StringFormat=N2}" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
